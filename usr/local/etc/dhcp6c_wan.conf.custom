## WAN override template (GUI interface: WAN)
## PROVIDER ROLE PLACEHOLDER: COMCAST / XFINITY
##
## This template is for the provider behavior that uses:
##   - ia-na 0
##   - ia-pd 0 and ia-pd 1 (two /60 delegations)
##
## If Comcast is attached to GUI WAN2 in your environment, assign this file to
## WAN2's DHCPv6 override instead of WAN.
##
## OPNsense substitutes {interface} with the real device name at startup
## (e.g. vtnet0, igc0) when writing /var/etc/dhcp6c_wan.conf.
##
## Keep exactly one interface block per override file.

interface {interface} {
  send rapid-commit;
  send ia-na 0;

  send ia-pd 0;
  send ia-pd 1;

  script "/usr/local/bin/dhcp6c_{interface}.sh";
  request domain-name-servers;
  request domain-name;
};

id-assoc na 0 { };

id-assoc pd 0 {
  prefix ::/60 21600 86400;
};

id-assoc pd 1 {
  prefix ::/60 21600 86400;
};
